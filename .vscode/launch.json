{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug samuTrain Server",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_server.py",
            "args": [
                "--reset-db",
                "--data-folder", "data/single_case",
                "--model-folder", "models/new_model"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/venv_310/Scripts/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}"
            }
        }
    ]
}
