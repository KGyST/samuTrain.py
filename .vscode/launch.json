{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "samuTrain: Debug Server (310)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_server.py",
      "python": "${workspaceFolder}/venv_310/Scripts/python.exe",
      "console": "integratedTerminal",
      "stopOnEntry": true,
      "args": [
        "--data-folder", "data/single_case",
        "--model-folder", "models/new_model"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/src"
      },
      "justMyCode": false,
      "subProcess": true,
      "cwd": "${workspaceFolder}"
    }
  ]
}