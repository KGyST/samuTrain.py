# *.so  # No .so files found
# .Python  # No .Python directory found
# build/  # No build directory found
# develop-eggs/  # No develop-eggs directory found
# dist/  # No dist directory found
# downloads/  # No downloads directory found
# eggs/  # No eggs directory found
