# lib/  # lib directory exists but contains samuLearnUI.ts submodule
# lib64/  # No lib64 directory found
# parts/  # No parts directory found
# sdist/  # No sdist directory found
# var/  # No var directory found
# wheels/  # No wheels directory found
# pip-wheel-metadata/  # No pip-wheel-metadata directory found
# share/python-wheels/  # No share/python-wheels directory found
# *.egg-info/  # No .egg-info directory found
# .installed.cfg  # No .installed.cfg file found
# *.egg  # No .egg files found
# MANIFEST  # No MANIFEST file found

